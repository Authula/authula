# Third party ENV variables

# Required for OAuth plugin.
# Register the exact callback URL with each provider, including the API base path,
# for example: https://api.example.com/api/auth/oauth2/callback/google
# PKCE (S256) is always enabled and cannot be disabled globally.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional: common (default), organizations, consumers or a specific tenant ID
MICROSOFT_TENANT_ID=

# Required depending on the plugin being used and their providers
POSTGRES_URL=
REDIS_URL=
KAFKA_BROKERS=
NATS_URL=
RABBITMQ_URL=

# Optional - Required only if using event bus consumers e.g. Redis/Kafka
EVENT_BUS_CONSUMER_GROUP=

# Authula ENV variables

OPENAPI_SPEC_VERSION=0.1.0
GO_ENV=development
PORT=8080

# Path to your configuration file (e.g., ./config.toml) (optional)
AUTHULA_CONFIG_PATH=
# The base URL of your API (optional if configured in the config file)
AUTHULA_BASE_URL=
# Used for encryption. Generate using `openssl rand -base64 32`
AUTHULA_SECRET=
# postgresql: "postgresql://username:password@localhost:5432/authula?sslmode=disable"
AUTHULA_DATABASE_URL=
# Cookie Domain attribute shared by all auth cookies (e.g. example.com). Leave empty for host-only cookies.
AUTHULA_COOKIE_DOMAIN=

# Email template overrides (optional) - Override default email templates via environment variables
# Each email type has three templates: SUBJECT, TEXT (plain text), HTML

# Email/Password Plugin Templates
AUTHULA_TEMPLATE_VERIFY_EMAIL_SUBJECT=
AUTHULA_TEMPLATE_VERIFY_EMAIL_TEXT=
AUTHULA_TEMPLATE_VERIFY_EMAIL_HTML=
AUTHULA_TEMPLATE_PASSWORD_RESET_REQUEST_SUBJECT=
AUTHULA_TEMPLATE_PASSWORD_RESET_REQUEST_TEXT=
AUTHULA_TEMPLATE_PASSWORD_RESET_REQUEST_HTML=
AUTHULA_TEMPLATE_PASSWORD_CHANGED_SUBJECT=
AUTHULA_TEMPLATE_PASSWORD_CHANGED_TEXT=
AUTHULA_TEMPLATE_PASSWORD_CHANGED_HTML=
AUTHULA_TEMPLATE_EMAIL_CHANGE_REQUEST_SUBJECT=
AUTHULA_TEMPLATE_EMAIL_CHANGE_REQUEST_TEXT=
AUTHULA_TEMPLATE_EMAIL_CHANGE_REQUEST_HTML=
AUTHULA_TEMPLATE_EMAIL_CHANGED_SUBJECT=
AUTHULA_TEMPLATE_EMAIL_CHANGED_TEXT=
AUTHULA_TEMPLATE_EMAIL_CHANGED_HTML=

# Magic Link Plugin Templates
AUTHULA_TEMPLATE_MAGIC_LINK_SIGN_IN_SUBJECT=
AUTHULA_TEMPLATE_MAGIC_LINK_SIGN_IN_TEXT=
AUTHULA_TEMPLATE_MAGIC_LINK_SIGN_IN_HTML=

# Organizations Plugin Templates
AUTHULA_TEMPLATE_ORGANIZATION_INVITATION_SUBJECT=
AUTHULA_TEMPLATE_ORGANIZATION_INVITATION_TEXT=
AUTHULA_TEMPLATE_ORGANIZATION_INVITATION_HTML=
